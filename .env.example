# Elysium testnet (chain 99801). THROWAWAY KEYS ONLY.
#
# The executor's key. It is the RopeMarket operator: it relays the Hyperliquid
# mark, opens and settles rounds, routes every order and holds the players'
# pooled test dollars. Needs a little testnet HYPE for gas
# (https://elysium.kinetiq.xyz/testnet-faucet). The web app never needs it.
PRIVATE_KEY=0x
# The web app has no key, so it is told the house address instead.
HOUSE_ADDRESS=

# Public — read by the browser too.
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
NEXT_PUBLIC_ASSET=HYPE
NEXT_PUBLIC_MARKET=
NEXT_PUBLIC_COLLATERAL=
NEXT_PUBLIC_REGISTRY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# The scoreboard the executor mirrors entries into (same as NEXT_PUBLIC_REGISTRY).
# Leave unset and the game runs identically without the on-chain mirror.
REGISTRY=

# Postgres — the ledger of whose pooled money is whose. Railway Postgres in
# production, shared by the executor and the web app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"

# Optional: Hyperliquid's info endpoint (default https://api.hyperliquid.xyz/info).
HL_INFO_URL=
